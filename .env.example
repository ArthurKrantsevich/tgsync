# tgsync node configuration.
# Copy to the node folder (~/.config/tgsync/.env on Linux,
# ~/Library/Application Support/tgsync/.env on macOS, %APPDATA%\tgsync\.env on
# Windows) and keep it private: chmod 600 .env.
# Full reference: docs/en/configuration.md
#
# Every line is VAR=value, no quotes needed, no spaces around "=".
# Changes take effect after the node restarts.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Token of this node's bot from @BotFather. Every node (machine) needs its own
# bot: one token can be polled by one process only.
TELEGRAM_BOT_TOKEN=123456:ABC-replace-with-your-token

# Telegram user ids allowed to control this node, comma separated.
# Messages and buttons from anyone else are silently ignored.
ALLOWED_USER_IDS=123456789

# Id of the forum group (Topics enabled), shared by all nodes.
# A supergroup id is negative and starts with -100.
GROUP_CHAT_ID=-1001234567890

# Absolute path to the folder with your projects. Every subfolder is a project.
PROJECTS_ROOT=/home/user/projects

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------

# Node name shown in topic titles ("🖥 laptop"). Default: the hostname.
NODE_NAME=

# SQLite database. A relative path is resolved in the node folder.
DB_PATH=./data/tgsync.db

# Path to the claude CLI when it is not on PATH. On Windows it must point to
# the native claude.exe, not npm's claude.cmd.
CLAUDE_CLI_PATH=

# ---------------------------------------------------------------------------
# Limits and timers
# Durations use Go syntax: 90s, 30m, 2h, 1h30m. "0" disables the timer.
# ---------------------------------------------------------------------------

# How many agent turns may run at the same time on this node. Others queue.
MAX_PARALLEL_SESSIONS=3

# Stop an idle claude process after this long. The next message resumes the
# session transparently. 0 keeps processes alive forever.
IDLE_TIMEOUT=2h

# Warn in the topic when a running turn shows no activity this long.
STALL_WARN=20m

# Remind about an unanswered permission request or question this often.
REMIND_EVERY=2h

# Hard limit for one turn: longer turns are interrupted. 0 means no limit.
MAX_TURN_DURATION=0

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# Files changed during a turn that are sent to the topic when the turn ends,
# comma separated. "**/" means "in any folder". Example: **/*.md,**/*.pdf
# Empty: only documents the agent mentions are sent (at most 5 per turn).
AUTO_SEND_GLOBS=

# Profile from profiles.yaml used when neither /new --profile nor the project
# sets one. "full" always exists: everything from ~/.claude, as in a terminal.
DEFAULT_PROFILE=full

# Show hook messages addressed to the user (systemMessage) and hook failures.
# true or false.
SHOW_HOOK_OUTPUT=true

# ---------------------------------------------------------------------------
# sudo (Linux and macOS only; always off on Windows)
# Read docs/en/configuration.md#sudo before enabling.
# ---------------------------------------------------------------------------

# off      - commands with sudo are rejected (default, safest).
# env      - the password comes from SUDO_PASSWORD below.
# telegram - after you approve a sudo command, the bot asks for the password
#            in the topic and deletes your message (needs the "Delete
#            messages" admin right).
# In every mode each sudo command still needs your button.
SUDO_MODE=off

# Only for SUDO_MODE=env. Stored in plain text: keep .env at chmod 600.
SUDO_PASSWORD=

# ---------------------------------------------------------------------------
# Voice messages (optional, self-hosted speech-to-text only)
# See deploy/stt/compose.yaml. Empty STT_URL disables voice messages.
# ---------------------------------------------------------------------------

# Base URL of an OpenAI-compatible transcription server you run yourself.
STT_URL=

# Model name passed to the server.
STT_MODEL=Systran/faster-whisper-small

# Time limit for downloading and transcribing one voice message.
STT_TIMEOUT=60s

# Longest voice message accepted, in seconds.
STT_MAX_SECONDS=300
